{
  "manifest_version": 3,
  "name": "ITEM journal",
  "version": "1.0",
  "description": "閲覧中の商品を国内外のサイトで横断比較できる拡張機能",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://cross-border-ec-finder.onrender.com/*"
  ]
}
